{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run alembic *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "mcp__postman__createCollection",
      "mcp__postman__createCollectionRequest",
      "mcp__postman__createCollectionResponse",
      "mcp__postman__createEnvironment",
      "mcp__postman__createMock",
      "mcp__postman__createSpec",
      "mcp__postman__createSpecFile",
      "mcp__postman__createWorkspace",
      "mcp__postman__duplicateCollection",
      "mcp__postman__generateCollection",
      "mcp__postman__generateSpecFromCollection",
      "mcp__postman__publishMock",
      "mcp__postman__putCollection",
      "mcp__postman__putEnvironment",
      "mcp__postman__syncCollectionWithSpec",
      "mcp__postman__syncSpecWithCollection",
      "mcp__postman__updateCollectionRequest",
      "mcp__postman__updateMock",
      "mcp__postman__updateSpecFile",
      "mcp__postman__updateSpecProperties",
      "mcp__postman__updateWorkspace"
    ],
    "deny": [
      "Read(.env)",
      "Bash(docker compose down *-v*)",
      "Bash(docker compose down *--volumes*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/openapi-al-dia.sh\"",
            "if": "Bash(git commit:*)",
            "timeout": 20,
            "statusMessage": "Comprobando openapi.json contra el código"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/tras-editar-especificacion.sh\"",
            "timeout": 20,
            "statusMessage": "Regenerando openapi.json"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/coleccion-postman-vieja.sh\"",
            "timeout": 10,
            "statusMessage": "Comprobando si la colección de Postman quedó vieja"
          }
        ]
      }
    ]
  }
}
